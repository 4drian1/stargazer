# ============================================================
# Stargazer 仓库 .gitignore —— 白名单制：宁可漏提，不可错提
# 纪律：密钥/数据/模型/构建产物/缓存 永不入库（见 README 密钥政策）
# ============================================================

# ── 默认全部忽略，再按子树放行 ──
*
!.gitignore
!README.md
!开发路线.txt
!交接摘要.md
!refresh_and_score_local.bat
!update.bat
!.gitattributes

# ── stargazer_desktop（桌面程序）──
!/stargazer_desktop/
!/stargazer_desktop/*.py
!/stargazer_desktop/test_learning_review_ui.js
!/stargazer_desktop/*.spec
!/stargazer_desktop/*.bat
!/stargazer_desktop/*.md
!/stargazer_desktop/requirements-shadow.txt
!/stargazer_desktop/agent/
!/stargazer_desktop/agent/__init__.py
!/stargazer_desktop/agent/brain.py
!/stargazer_desktop/web/
!/stargazer_desktop/web/**
/stargazer_desktop/dist/
/stargazer_desktop/build/
/stargazer_desktop/data/
/stargazer_desktop/__pycache__/
/stargazer_desktop/*.log
# 真实 config 含 token，只入库 example
/stargazer_desktop/config.yaml
!/stargazer_desktop/config.example.yaml

# ── stargazer_plan（交易计划库 CLI/状态机）──
!/stargazer_plan/
!/stargazer_plan/*.py
!/stargazer_plan/*.md
!/stargazer_plan/plan_db/
!/stargazer_plan/plan_db/*.py
!/stargazer_plan/spec/
!/stargazer_plan/spec/**
/stargazer_plan/data/
/stargazer_plan/__pycache__/
/stargazer_plan/frozen_*.json
/stargazer_plan/events_*.jsonl
/stargazer_plan/*.log

# ── corvus（信息采集）──
!/corvus/
!/corvus/*.py
!/corvus/*.md
!/corvus/*.txt
!/corvus/*.bat
!/corvus/*.vbs
!/corvus/requirements.txt
!/corvus/corvus/
!/corvus/corvus/*.py
!/corvus/spec/
!/corvus/spec/**
/corvus/config/
!/corvus/config/*.example.yaml
!/corvus/config/instruments.yaml
!/corvus/config/sources.yaml
/corvus/data/
/corvus/__pycache__/

# ── stargazer_ml 精选脚本子树（排除一切数据/模型/缓存）──
!/stargazer_ml/
/stargazer_ml/*/
!/stargazer_ml/v5_hybrid/
/stargazer_ml/v5_hybrid/*/
!/stargazer_ml/v5_hybrid/green_watch_v0/
!/stargazer_ml/v5_hybrid/green_v2/
!/stargazer_ml/v5_hybrid/opportunity_v2/
!/stargazer_ml/v5_hybrid/step9_preflight/
!/stargazer_ml/v5_hybrid/latr_v0/
!/stargazer_ml/v5_hybrid/green_exit_v1/
!/stargazer_ml/v5_hybrid/a0a4/
!/stargazer_ml/v5_hybrid/pullback_train/
# 各子树只放行代码/文档/规格
!/stargazer_ml/v5_hybrid/*/*.py
!/stargazer_ml/v5_hybrid/*/*.md
!/stargazer_ml/v5_hybrid/*/*.yaml
!/stargazer_ml/v5_hybrid/*/*.txt
!/stargazer_ml/v5_hybrid/*/*.json
/stargazer_ml/v5_hybrid/green_v2/daily_dual_list_*.md
/stargazer_ml/v5_hybrid/green_v2/holdings_watch_*.md
/stargazer_ml/v5_hybrid/*/_*/
/stargazer_ml/v5_hybrid/*/_*.parquet
/stargazer_ml/v5_hybrid/*/__pycache__/
/stargazer_ml/v5_hybrid/pullback_train/*/
!/stargazer_ml/v5_hybrid/pullback_train/*.py

# ── GREEN-CAR 双路径研究线（#16 轨）：代码+合同入库，RUN 数据目录不入 ──
!/stargazer_ml/v5_hybrid/green_common_profile/
!/stargazer_ml/v5_hybrid/green_common_profile/contracts/
/stargazer_ml/v5_hybrid/green_common_profile/contracts/*/
!/stargazer_ml/v5_hybrid/green_common_profile/contracts/*.md
!/stargazer_ml/v5_hybrid/green_common_profile/contracts/*.py
!/stargazer_ml/v5_hybrid/green_common_profile/contracts/*.json
# pullback_train 实际在 stargazer_ml 根（不在 v5_hybrid 下），修正历史错位
!/stargazer_ml/pullback_train/
/stargazer_ml/pullback_train/*/
!/stargazer_ml/pullback_train/*.py

# ── R0-V1 风险研究线：代码+文档+小JSON证据入库（数据/大产物仍由全局兜底排除）──
!/stargazer_ml/v5_hybrid/risk_r0_v1/
!/stargazer_ml/v5_hybrid/risk_r0_v1/*.py
!/stargazer_ml/v5_hybrid/risk_r0_v1/*.md
!/stargazer_ml/v5_hybrid/risk_r0_v1/*.json

# 快照契约预留：仅这些源码/测试/说明可见，不开放研究产物子树
!/stargazer_ml/v5_hybrid/opportunity_v2/contracts/
!/stargazer_ml/v5_hybrid/opportunity_v2/contracts/snapshot_contracts.py
!/stargazer_ml/v5_hybrid/opportunity_v2/contracts/snapshot_contracts_v2.py
!/stargazer_ml/v5_hybrid/opportunity_v2/contracts/test_snapshot_contracts_v2.py
!/stargazer_ml/v5_hybrid/opportunity_v2/contracts/README_v2.md

# ── 其它 ──
!/docs/
!/docs/*.md
!/migration_support/
!/docs/
!/docs/*.md
!/migration_support/*
/migration_support/config_portable.yaml

# ── C3 pack（Corvus C3/C4 自包含包）──
# 仅源码/文档/合同入库；out/ 产物、.c3venv、模型 artifacts 由全局兜底排除
!/c3/
/c3/*
!/c3/*.py
!/c3/*.md
!/c3/*.bat
!/c3/*.ps1
!/c3/corvus/
/c3/corvus/*
!/c3/corvus/*.py
!/c3/corvus/materiality_v1/
/c3/corvus/materiality_v1/*
!/c3/corvus/materiality_v1/*.py
!/c3/corvus/materiality_v1/feature_contract.json

# ── 全局兜底（即使将来有人放宽白名单，这些也永不出现在任何提交）──
**/*.parquet
**/*.pkl
**/*.sqlite
**/*.sqlite-journal
**/*.db
**/*.log
**/*.zip
**/*.exe
**/*.dll
**/*.pyd
**/*.env
**/.env*
**/*.gguf
**/tokens.yaml
**/.secrets/
**/data/assistant/
**/__pycache__/

