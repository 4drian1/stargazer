# Stargazer 本机环境占位（复制为 .env 或直接在系统环境变量中设置）。
# 本文件只放占位符，真实值永不入库。被 .gitignore 排除的是 .env 本身。

# ── CLI（stargazer_plan）日线分区目录 ──
# 优先级：环境变量 > stargazer_plan/data/daily_parts_root.txt > 旧缺省
STARGAZER_DAILY_PARTS=D:/your-data/data_daily_parts

# ── 通达信 vipdoc 目录（桌面版与采集脚本共用）──
# 优先级：环境变量 > <程序目录>/data/tdx_root.txt > 占位
STARGAZER_TDX_ROOT=D:/tdx/vipdoc

# ── 外部 Python 解释器（worker/批处理脚本用）──
STARGAZER_PYTHON=D:/python/Scripts/python.exe

# ── 可选：计划库 PostgreSQL（不设置则 CLI 的计划功能不可用）──
STARGAZER_PG_DSN=postgresql://user:password@localhost:5432/stargazer_plan

# ── 可选：DeepSeek（不设置则本机密钥文件或设置页 DPAPI 存储生效）──
DEEPSEEK_API_KEY=
